# API
PORT=3000

# Postgres connection (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=perso
DB_PASSWORD=perso
DB_NAME=perso

# Set to "true" to log every SQL statement
DB_LOGGING=false

# JWT configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS origin for web app
CORS_ORIGIN=
