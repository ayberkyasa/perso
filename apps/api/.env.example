# API
PORT=3000

# Postgres connection (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=perso
DB_PASSWORD=perso
DB_NAME=perso

# Set to "true" to log every SQL statement
DB_LOGGING=false

# Authentication
# Secret used to sign JWTs. REQUIRED — the API will not start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret
# Set to "true" to allow sign-ups beyond the first (owner) account.
# When "false" (default), only the first account can be created.
ALLOW_REGISTRATION=false

# Comma-separated list of origins allowed to call the API (CORS).
# Leave unset to allow any origin (fine for local single-user use).
# CORS_ORIGIN=http://localhost:5173
